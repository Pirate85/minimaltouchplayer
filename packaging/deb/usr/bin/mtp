#!/usr/bin/env bash
# MinimalTouchPlayer (MTP) — system launcher (v1.2.1+)
# CustomTkinter + darkdetect sind vendored im Paket → kein pip nötig!
set -euo pipefail

APP_DIR="/usr/share/mtp"
VENDOR_DIR="${APP_DIR}/vendor"

if [[ ! -f "${APP_DIR}/mtp.py" ]]; then
    echo "Error: mtp.py not found at ${APP_DIR}/mtp.py" >&2
    exit 1
fi

# --- System-Dependencies (Nicht vendored — müssen im System sein) ---------
python3 -c "import numpy" 2>/dev/null || {
    echo "❌ Missing dependency: python3-numpy"
    echo ""
    echo "   Ubuntu/Debian: sudo apt install python3-numpy"
    echo "   Fedora/RHEL:   sudo dnf install python3-numpy"
    exit 1
}

python3 -c "import PIL" 2>/dev/null || {
    echo "❌ Missing dependency: Pillow (PIL)"
    echo ""
    echo "   Ubuntu/Debian: sudo apt install python3-pil"
    echo "   Fedora/RHEL:   sudo dnf install python3-pillow"
    exit 1
}

# --- Start ---------------------------------------------------------------
# PYTHONPATH macht den Vendor-Ordner für Python sichtbar (customtkinter, darkdetect)
cd "$APP_DIR"
exec env PYTHONPATH="${VENDOR_DIR}${PYTHONPATH:+:${PYTHONPATH}}" python3 mtp.py "$@"
